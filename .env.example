# ======================================================
# yt-downloader .env
# Copy to .env:  cp .env.example .env
# Settings below are read automatically by docker-compose.
# ======================================================

# --- Database (3 modes, all driven from .env) ---
# 1) DB_MODE=local  -> SQLite file on this PC (no network).         (default)
# 2) DB_MODE=cloud  + DB_URI to a VPS IP directly (no tunnel).
#        DB_URI=mysql://$DB_USER:$DB_PASSWORD@<VPS_IP>:<PORT>/$DB_DATABASE
#        (use the port exposed on the VPS host, e.g. :3307)
# 3) DB_MODE=cloud  + DB_URI to 127.0.0.1 (= tunnel mode).
#        run.sh auto-starts the cloudflared-mysql-tcp container,
#        which relays to CF_TUNNEL_HOSTNAME -> Cloudflare -> VPS DB.
DB_MODE=local

# Local mode: container path to the SQLite file.
#DB_FILE=/app/.yt-dlp-config/history.db

# Cloud mode: MySQL connection string (user, password, host, port, database).
# All PCs that must share history set this to the SAME value.
# --- VPS-IP mode (no tunnel) ---
#DB_URI=mysql://user:pass@103.0.0.1:3307/history
# --- Tunnel mode (via Cloudflare) ---
#DB_URI=mysql://user:pass@127.0.0.1:3307/history

# --- Cloudflare tunnel (used only when DB_URI host == 127.0.0.1) ---
#CF_TUNNEL_HOSTNAME=db-yt-downloader.example.tld
#CF_ACCESS_CLIENT_ID=
#CF_ACCESS_CLIENT_SECRET=

# --- Runtime user (auto-detected by run.sh, usually no need to change) ---
#USER=appuser
#UID=1000
#GID=1000

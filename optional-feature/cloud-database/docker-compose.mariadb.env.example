# ======================================================
# MariaDB server .env (used ONLY by docker-compose.mariadb.yml
# on the cloud host / VPS). Copy to .env on that host:
#   cp docker-compose.mariadb.env.example .env
# ======================================================

# Name of the database that PC1/PC2 will connect to.
DB_DATABASE=history

# Database user/password for the yt-downloader app.
# These become part of each PC's DB_URI.
DB_USER=gylang
DB_PASSWORD=change-me-strong

# Admin (root) password for managing the server (backups, users, etc).
DB_ROOT_PASSWORD=change-me-root

# Port to expose (default 3306).
DB_PORT=3306
